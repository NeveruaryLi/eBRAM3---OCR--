# ──────────────────────────────────────────────
# GPTBots 服务配置（必填）
# ──────────────────────────────────────────────
# Agent A：GPTBots 逐页分析 Agent 的 API 密钥
api_key=app-xxxxxxxxxxxxxxxxxxxxxxxx

# Agent B：GPTBots 综合分析 Agent 的 API 密钥（Case 1 使用）
AGENT_B_API_KEY=app-xxxxxxxxxxxxxxxxxxxxxxxx

# Agent C：GPTBots 调解员简报 Agent 的 API 密钥（Case 2 使用）
AGENT_C_API_KEY=app-xxxxxxxxxxxxxxxxxxxxxxxx

# Agent J：HKLII 案例摘要 Agent 的 API 密钥（Case 5 使用）
AGENT_J_API_KEY=app-xxxxxxxxxxxxxxxxxxxxxxxx

# GPTBots API 端点（默认新加坡节点，无需修改）
base_url=https://api-sg.gptbots.ai/v2/conversation/message
create_conversation_url=https://api-sg.gptbots.ai/v1/conversation

# ──────────────────────────────────────────────
# 飞桨 PaddleOCR 官方 API 配置（必填）
# ──────────────────────────────────────────────
# 飞桨 PaddleOCR 官方 API 令牌（在 aistudio.baidu.com 生成）
PADDLE_OCR_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ──────────────────────────────────────────────
# 其他配置（可选）
# ──────────────────────────────────────────────
# 默认用户 ID（无特殊需求不用改）
gptbots_user_id=local_user
